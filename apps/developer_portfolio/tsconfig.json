{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        // The existing React source imports types as value imports (e.g.
        // `import { Post } from "./Post"`). Astro's preset enables
        // verbatimModuleSyntax, which preserves those imports verbatim and
        // breaks hydration at runtime. Disable it to keep type-only imports
        // elided, matching the original Vite behavior.
        "verbatimModuleSyntax": false
    },
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"]
}
